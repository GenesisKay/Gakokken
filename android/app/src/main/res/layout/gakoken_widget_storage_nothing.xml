<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
        android:shadowColor="#66000000"
        android:shadowRadius="6"
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/gakoken_widget_storage_name"
                android:textColor="#FFF7F7F5"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="horizontal">
            <TextView
        android:shadowColor="#66000000"
        android:shadowRadius="6"
                android:id="@+id/widget_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFeatureSettings="tnum"
                android:fontFamily="@font/doto"
                android:fontVariationSettings="'wght' 900"
                android:text="45.2 GB"
                android:textColor="#FFF7F7F5"
                android:textSize="32sp" />
            <TextView
        android:shadowColor="#66000000"
        android:shadowRadius="6"
                android:id="@+id/widget_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginBottom="3dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:text=" / 128 GB"
                android:textColor="#FFF7F7F5"
                android:textSize="14sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/widget_bar"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="10dp"
            android:scaleType="fitStart"
            android:src="@drawable/gakoken_widget_bar_preview"
            android:importantForAccessibility="no" />
        <TextView
        android:shadowColor="#66000000"
        android:shadowRadius="6"
            android:id="@+id/widget_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:text="82.8 GB"
            android:textColor="#FFF7F7F5"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:shadowColor="#66000000"
        android:shadowRadius="6"
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#FFF7F7F5"
        android:visibility="gone" />
</FrameLayout>
